{
  "name": "node-journey",
  "version": "1.0.0",
  "description": "Node Part 2 - Express Tasks with Database Setup (Migrate, Seed, Drop, Testing, Logging)",
  "main": "src/express-server.js",
  "scripts": {
    "test": "jest --detectOpenHandles --forceExit",
    "dev": "nodemon src/express-server.js",
    "start": "node src/express-server.js",
    "db:migrate": "node src/scripts/migrate.js",
    "db:seed": "node src/scripts/seed.js",
    "db:drop": "node src/scripts/drop.js",
    "db:reset": "npm run --silent db:drop && npm run --silent db:migrate && npm run --silent db:seed"
  },
  "keywords": [
    "node",
    "express",
    "mongodb",
    "mongoose",
    "migration",
    "seeding",
    "testing",
    "logging"
  ],
  "author": "Asad Nouman",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "chalk": "^5.6.0",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "mongoose": "^8.18.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  }
}
